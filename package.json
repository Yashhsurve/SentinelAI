{
  "name": "sentinel-ai",
  "version": "1.0.0",
  "description": "SentinelAI: Autonomous Security Investigator for Messages and Code",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite client --port 5173",
    "build": "vite build client",
    "preview": "vite preview client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"client/**/*.{js,jsx,css}\" \"server/**/*.js\" \"shared/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google/genai": "^2.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
